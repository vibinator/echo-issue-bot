{
  "name": "echo-issue-bot",
  "version": "1.2.0",
  "description": "Discord bot that collects Echo VR player problems, groups similar ones, and lets devs track status.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --no-warnings --env-file=.env src/index.js",
    "test": "node --no-warnings src/test.js && node --no-warnings src/e2e.js",
    "e2e": "node --no-warnings src/e2e.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "discord.js": "^14.16.0",
    "tesseract.js": "^7.0.0"
  }
}
