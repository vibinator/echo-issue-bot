DISCORD_TOKEN=your-bot-token
# Optional: register commands to one server instantly (recommended while testing)
GUILD_ID=
# Only members with this role (and developers) can create reports. Leave empty to allow everyone.
# /setup reporter_role:@Role overrides this per server.
REPORTER_ROLE_ID=1280768733136027755
# ONLY members with this role can change a ticket's status (Manage Server does not bypass it).
# Leave empty to let any developer do it. /setup status_role:@Role overrides this per server.
STATUS_ROLE_ID=1512852658971607121
